# 公开仓库只接收明确允许的项目文件；本机新增文件默认不入库。
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/LICENSE
!/requirements.txt
!/pytest.ini
!/pdf-manage.spec
!/run.py
!/run.pyw
!/run.bat
!/build.bat
!/build_setup.bat
!/app/
!/tests/
!/packaging/
!/docs/
!/.github/
/.github/**
!/.github/workflows/
!/.github/workflows/ocr.yml

# 应用源码与经过检查的图标。私人赞赏码暂留本机。
/app/**
!/app/**/
!/app/**/*.py
!/app/README.md
!/app/assets/app.png
!/app/assets/pdf.svg

# 测试只入库代码，样例文档由测试自行生成。
/tests/**
!/tests/**/
!/tests/**/*.py

# 构建源码、依赖清单、安装器配置和第三方许可说明。
/packaging/**
!/packaging/**/
!/packaging/**/*.py
!/packaging/pdf-manage.iss
!/packaging/requirements-build.txt
!/packaging/requirements-ocr.txt
!/packaging/licenses/*.txt

# 对外维护说明；旧开发记录、验收记录和截图留在本机。
/docs/**
!/docs/DEVELOPMENT.md
!/docs/REPOSITORY.md
!/docs/ACCEPTANCE.md
!/docs/OCR.md
!/docs/DOCUMENT_LAYOUT_PLAN.md
!/docs/RELEASE_REVIEW_0_4.md
!/docs/issues.md
!/docs/images/
!/docs/images/reading.png
!/docs/images/arrange.png
!/docs/images/OCR导出效果图01.png
!/docs/images/OCR导出效果图02.png
!/docs/images/OCR导出效果图03.png

# 依赖、缓存、本机配置和产物，任何目录均不入库。
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.idea/
.vscode/
.codex/
.agents/
.aws/
.env
.env.*
*.log
*.jsonl
*.exe
*.dll
*.pyd
*.ico
*.zip
*.7z
*.rar
*.bak
*.tmp
*.db
*.sqlite*
*.key
*.pem
*.pfx
*.p12
*.onnx
*.pt
*.pth
*.safetensors
dist/
dist-installer/
dist-ocr*/
build/
credentials*

# 真实业务文档和数据导出不作为源文件。
*.pdf
*.ofd
*.doc
*.docx
*.xls
*.xlsx
*.csv
Thumbs.db
Desktop.ini
.DS_Store
